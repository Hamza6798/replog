# Copy this file to ".env" and fill in your own values. Never commit ".env".
# Supabase dashboard > Project Settings > Data API (URL) and API Keys (publishable key).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Only the public (publishable / anon) key belongs here. NEVER put the secret / service_role key in this project.
